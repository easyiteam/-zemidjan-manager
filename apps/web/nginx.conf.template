# Substitué par l'entrypoint officiel nginx (envsubst sur les variables
# d'environnement définies) : seules ${PORT} et ${API_ORIGIN} sont remplacées,
# les variables nginx natives ($host, $remote_addr, ...) restent littérales.
server {
  listen ${PORT};
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Le navigateur ne parle qu'à ce domaine (cookie de refresh same-site) ;
  # nginx relaie /api/ vers le domaine PUBLIC du service api (pas de réseau
  # privé Railway possible depuis le navigateur).
  location /api/ {
    proxy_pass ${API_ORIGIN}/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location = /manifest.webmanifest {
    default_type application/manifest+json;
    add_header Cache-Control "no-cache";
  }

  location ~* \.(?:js|css)$ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }

  location ~* sw\.js$ {
    try_files $uri =404;
    add_header Cache-Control "no-cache";
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
