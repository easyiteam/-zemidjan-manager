# Rôle propriétaire — utilisé uniquement par `prisma migrate`/`prisma generate`
# et par les scripts de bootstrap (création du rôle applicatif).
DATABASE_URL="postgresql://postgres:postgres@localhost:54329/zm_dev"

# Rôle applicatif à droits limités (SELECT/INSERT/UPDATE/DELETE, pas de DDL) —
# c'est celui que PrismaService utilise à l'exécution. Généré par
# scripts/db-bootstrap.cjs si absent en dev.
APP_DATABASE_URL="postgresql://zm_app_user:zm_app_password@localhost:54329/zm_dev"

PORT=3000
NODE_ENV=development

# Secrets JWT — à régénérer en production (ex: `openssl rand -hex 32`)
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"

# Driver de stockage des captures MoMo : "memory" (dev/test, défaut hors prod)
# ou "s3" (MinIO / Railway Buckets / Cloudflare R2 / Backblaze B2).
STORAGE_DRIVER=memory
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="zm-files"

# Origine du frontend autorisée en CORS (service `web` en production)
WEB_ORIGIN="http://localhost:5173"
